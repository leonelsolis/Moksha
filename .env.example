# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env

# ── Obligatorio siempre ──────────────────────────────────────────────
# Firma las sesiones del panel. Mínimo 32 caracteres.
# Generá uno con:  openssl rand -base64 32
# Si lo cambiás, se cierran todas las sesiones abiertas.
AUTH_SECRET=

# ── Base de datos ────────────────────────────────────────────────────
# En desarrollo no hace falta nada: se usa el archivo ./data/turnos.db
#
# En producción (Vercel) hay que apuntar a Turso. Las dos variables se
# sacan con la CLI de Turso; ver el README.
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=

# Solo si querés el archivo local en otra ruta.
# DATABASE_PATH=data/turnos.db

# ── Opcionales ───────────────────────────────────────────────────────
# Dirección pública del sitio. Solo se usa para armar el link de cancelación
# dentro de los emails; en pantalla el link se arma solo.
# APP_URL=https://turnos.tudominio.com

# Envío de emails con Resend. Además hay que activarlo desde Ajustes.
# RESEND_API_KEY=

# Solo para la carga inicial (npm run db:seed). Si no las ponés, se generan
# contraseñas al azar y se muestran una vez por pantalla.
# ADMIN_PASSWORD=
# STAFF_PASSWORD=
