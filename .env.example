# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env

# ── Obligatorio siempre ──────────────────────────────────────────────
# Firma las sesiones del panel. Mínimo 32 caracteres.
# Generá uno con:  openssl rand -base64 32
# Si lo cambiás, se cierran todas las sesiones abiertas.
AUTH_SECRET=

# ── Base de datos ────────────────────────────────────────────────────
# En desarrollo no hace falta nada: se usa el archivo ./data/turnos.db
#
# En producción (Vercel) hay que apuntar a Turso. Las dos variables se
# sacan con la CLI de Turso; ver el README.
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=

# Solo si querés el archivo local en otra ruta.
# DATABASE_PATH=data/turnos.db

# ── Fotos de las profesionales ───────────────────────────────────────
# Se crea desde Vercel: pestaña Storage → Create → Blob. Al conectarlo al
# proyecto, Vercel carga esta variable sola en producción.
# Para poder subir fotos también desde tu computadora, traela con:
#   npx vercel env pull .env.local
# BLOB_READ_WRITE_TOKEN=

# ── Opcionales ───────────────────────────────────────────────────────
# Dirección pública del sitio. Solo se usa para armar el link que va dentro de
# los emails. Sin esto el link se arma con el dominio por el que entró el
# cliente, que funciona igual; ponela para fijar cuál es el dominio bueno.
# APP_URL=https://turnos.tudominio.com

# Envío de emails con Resend. La clave sale de https://resend.com/api-keys.
# Además hay que cargar el remitente y activar el envío desde Ajustes, y
# probarlo desde "Ajustes → Probar el envío". Ver el README.
# RESEND_API_KEY=

# Solo para la carga inicial (npm run db:seed), que crea tres cuentas: una de
# administración y una por profesional. Si no ponés las contraseñas, se generan
# al azar y se muestran una única vez por pantalla.
# ADMIN_PASSWORD=
# PROF1_PASSWORD=
# PROF2_PASSWORD=

# Email de contacto de cada cuenta: es a donde le llegan a la profesional los
# avisos de turno nuevo y de cancelación. Se pueden completar después desde
# el panel, en Usuarios.
# ADMIN_EMAIL=
# PROF1_EMAIL=
# PROF2_EMAIL=
